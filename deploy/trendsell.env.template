# Environment for the TrendSell API. Install as /etc/trendsell/trendsell.env with
# ownership root:trendsell and mode 0640. Never commit a filled-in copy.
#
# Values below are placeholders. Replace each one; the API refuses to start when
# APP_ENV=production and DATABASE_URL, CORS_ORIGINS or RATE_KEY_SECRET is invalid.

APP_ENV=production
# The selected release scope. This release refuses public or paid production tiers.
RELEASE_TIER=controlled_pilot
# PostgreSQL only in production. Percent-encode any reserved character in the password.
# Runtime role only: CONNECT plus SELECT/INSERT/UPDATE/DELETE on application tables.
# It must not own schema objects or receive CREATE/TEMP/TRUNCATE/TRIGGER rights.
DATABASE_URL=postgresql+psycopg://RUNTIME_USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Explicit HTTPS origins, comma separated. A wildcard is rejected.
CORS_ORIGINS=https://YOUR-DOMAIN
# Canonical browser origin embedded in account and invitation links. Required when the
# first CORS origin is not the public UI.
PUBLIC_APP_URL=https://YOUR-DOMAIN
# The controlled pilot is invitation-only. Production refuses to start if this is true.
ALLOW_REGISTRATION=false
# Research jobs per workspace per day.
RESEARCH_DAILY_LIMIT=20
# Authentication limits per hour. The address limits are generous because a shared
# network is one address; the account limit bounds guessing spread across addresses.
LOGIN_IP_HOURLY_LIMIT=30
LOGIN_ACCOUNT_HOURLY_LIMIT=10
REGISTER_IP_HOURLY_LIMIT=10
# Bound invitation email abuse per owner workspace and per recipient address.
INVITATION_WORKSPACE_HOURLY_LIMIT=20
INVITATION_EMAIL_DAILY_LIMIT=3
# Independent random value (at least 32 characters) used only to HMAC low-entropy
# network/email rate-limit identifiers before they enter PostgreSQL. Generate separately
# from every database, metrics or provider credential; the API requires it in production.
RATE_KEY_SECRET=
# Writes per workspace per minute, so one busy workspace cannot crowd out another.
WORKSPACE_WRITE_MINUTE_LIMIT=60
# Operational metrics surface. Counters are fleet-wide, so owning a workspace is not
# operating the service (review finding R07). Unset means the surface is off.
METRICS_TOKEN=
# How long readiness may reuse its physical-schema verdict, in seconds (R09).
SCHEMA_RECHECK_SECONDS=30
# Audit events contain pseudonymous account/workspace ids but no record payloads. They are
# swept at startup after this many days. Keep the notice shown to users in sync.
AUDIT_RETENTION_DAYS=365
# Restricted filesystem register outside PostgreSQL. The service writes deletion intent
# here before deleting live rows; restore procedures replay it after an older backup.
DELETION_REGISTER_DIR=/var/lib/trendsell/deletions
# Legacy adapter only; not a live-pilot source. Its standard affiliate terms do not fit
# TrendSell's durable multi-source research record.
AMAZON_CREATORS_ENABLED=false
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_CREATORS_PARTNER_TAG=
AMAZON_CREATORS_MARKETPLACE=www.amazon.com
AMAZON_CREATORS_USAGE_RIGHTS=
AMAZON_CREATORS_TIMEOUT_SECONDS=12
# Selected live-pilot collectors. Store secret values in this root-owned server file,
# never in VITE_* variables. Keep a collector disabled until DATAFORSEO_USAGE_RIGHTS,
# BRIGHTDATA_JUMIA_USAGE_RIGHTS, or OPEN_EXCHANGE_RATES_USAGE_RIGHTS identifies the
# applicable accepted terms, plan and intended-use basis. Published terms can establish
# permission; only genuinely unresolved target/display questions need clarification.
# Credential presence/authentication alone is not a live connection.
DATAFORSEO_ENABLED=false
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_USAGE_RIGHTS=
DATAFORSEO_CATALOG_LOCATION_CODE=2840
DATAFORSEO_TRENDS_LOCATION_CODE=2566
DATAFORSEO_RETENTION_DAYS=30
DATAFORSEO_TIMEOUT_SECONDS=15
BRIGHTDATA_JUMIA_ENABLED=false
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_JUMIA_DATASET_ID=
BRIGHTDATA_JUMIA_USAGE_RIGHTS=
BRIGHTDATA_JUMIA_RETENTION_DAYS=30
BRIGHTDATA_TIMEOUT_SECONDS=65
OPEN_EXCHANGE_RATES_ENABLED=false
OPEN_EXCHANGE_RATES_APP_ID=
OPEN_EXCHANGE_RATES_USAGE_RIGHTS=
OPEN_EXCHANGE_RATES_RETENTION_DAYS=365
OPEN_EXCHANGE_RATES_TIMEOUT_SECONDS=12
# Actionable import review is disabled until a qualified reviewer, Nigeria jurisdiction,
# supported categories, independence/cadence and appeal path are approved. Enabling it
# requires a non-secret reference to that signed scope.
IMPORT_REVIEW_ENABLED=false
IMPORT_REVIEW_POLICY_REF=
# Outbound mail (P03). `sink` and `log` are development-only. Production can use any
# standards-compliant SMTP submission provider with TLS. Keep MAIL_TRANSPORT empty until
# the sending identity, credentials, SPF/DKIM/DMARC and delivery monitoring are verified.
MAIL_TRANSPORT=
# Directory a 'sink' transport writes to. Ignored by every other transport.
MAIL_SINK_DIR=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
# Backup timer inputs (P06). DATABASE_URL is reused without being copied to another
# secret. Decide these values before installing/enabling the backup unit and timer.
TRENDSELL_BACKUP_DIR=/var/backups/trendsell
TRENDSELL_BACKUP_KEEP=14
# Required before a real-user pilot. The IAM identity must be restricted to this private
# bucket/prefix, and the bucket must enforce TLS, encryption and lifecycle expiry.
TRENDSELL_BACKUP_S3_URI=s3://YOUR-PRIVATE-BUCKET/trendsell
TRENDSELL_BACKUP_S3_SSE=AES256
# Separate immutable prefix for deletion intent. The same scoped backup identity may put,
# get and list these objects but must not delete them.
TRENDSELL_DELETION_S3_URI=s3://YOUR-PRIVATE-BUCKET/trendsell/deletions
