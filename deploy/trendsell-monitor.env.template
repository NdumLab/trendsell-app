# Install as /etc/trendsell/monitor.env, root:trendsell-monitor mode 0640. The database
# identity is a separate CONNECT + pg_monitor role, never the web or migration role.
TRENDSELL_MONITOR_STATE_DIR=/var/lib/trendsell-monitor
TRENDSELL_READY_URL=http://127.0.0.1:8021/api/ready
TRENDSELL_SERVICE_UNIT=trendsell.service
TRENDSELL_MONITOR_DATABASE_URL=postgresql+psycopg://MONITOR_USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
TRENDSELL_DISK_PATH=/
TRENDSELL_BACKUP_CHECK_COMMAND=/opt/trendsell/current/scripts/check_recovery_state.sh
TRENDSELL_PUBLIC_HOST=YOUR-DOMAIN
TRENDSELL_PUBLIC_PORT=443
TRENDSELL_SMTP_CHECK_HOST=
TRENDSELL_SMTP_CHECK_PORT=587

# Generic operator-selected HTTPS destinations. Heartbeats let an external dead-man
# detect a stopped host/timer. Leaving alert delivery blank is visible as undeliverable.
TRENDSELL_ALERT_WEBHOOK_URL=
TRENDSELL_ALERT_WEBHOOK_TOKEN=
TRENDSELL_HEARTBEAT_URL=

# Proposed pilot targets, not approvals.
TRENDSELL_MONITOR_HISTORY_DAYS=30
TRENDSELL_MONITOR_INTERVAL_MINUTES=5
TRENDSELL_ALERT_REMINDER_MINUTES=240
TRENDSELL_DISK_WARNING_PCT=20
TRENDSELL_DISK_CRITICAL_PCT=10
TRENDSELL_DB_WARNING_PCT=70
TRENDSELL_DB_CRITICAL_PCT=85
TRENDSELL_LATENCY_WARNING_MS=1000
TRENDSELL_LATENCY_CRITICAL_MS=3000
TRENDSELL_ERROR_WARNING_PCT=2
TRENDSELL_ERROR_CRITICAL_PCT=5
TRENDSELL_RATE_LIMIT_WARNING_PCT=5
TRENDSELL_RATE_LIMIT_CRITICAL_PCT=20
TRENDSELL_TLS_WARNING_DAYS=30
TRENDSELL_TLS_CRITICAL_DAYS=14
TRENDSELL_RESTART_WARNING_COUNT=1
TRENDSELL_RESTART_CRITICAL_COUNT=3
