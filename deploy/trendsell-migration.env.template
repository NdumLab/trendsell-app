# Install as /etc/trendsell/migration.env, root:root mode 0600. systemd reads it before
# changing to the dedicated trendsell-migrate identity; the web identity cannot read it.
# The database role owns the public schema/application objects but has no
# superuser, CREATEDB, CREATEROLE, replication or BYPASSRLS attribute.
APP_ENV=production
RELEASE_TIER=controlled_pilot
DATABASE_URL=postgresql+psycopg://MIGRATION_USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
CORS_ORIGINS=https://YOUR-DOMAIN
ALLOW_REGISTRATION=false
RATE_KEY_SECRET=NOT_USED_BY_MIGRATION_BUT_REQUIRED_BY_SETTINGS_VALIDATION
DELETION_REGISTER_DIR=/var/lib/trendsell/deletions
