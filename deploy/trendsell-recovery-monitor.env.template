# Optional recovery inputs for trendsell-monitor. Install as
# /etc/trendsell/recovery-monitor.env, root:trendsell-monitor mode 0640. If the host uses
# an IAM instance role, omit static AWS credentials. The identity needs read/head/list on
# the private backup prefix and no database permissions. Deletion-register PUT access stays
# isolated in /etc/trendsell/backup-s3.env for the dedicated sync service.
TRENDSELL_BACKUP_DIR=/var/backups/trendsell
TRENDSELL_BACKUP_MAX_AGE_HOURS=30
TRENDSELL_BACKUP_S3_URI=s3://YOUR-PRIVATE-BUCKET/trendsell
TRENDSELL_BACKUP_S3_SSE=AES256
TRENDSELL_DELETION_SYNC_TIMER=trendsell-deletion-register-sync.timer
TRENDSELL_DELETION_SYNC_SERVICE=trendsell-deletion-register-sync.service
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
