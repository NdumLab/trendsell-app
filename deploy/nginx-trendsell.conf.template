# nginx site template for TrendSell (action plan P01).
# Substitute ${TRENDSELL_DOMAIN} and install as /etc/nginx/sites-available/<domain>.
# This file carries no secrets: certificates, the database URL and every credential
# live outside the repository (see docs/RUNBOOK.md).
# client_max_body_size here must stay at or below the API's own byte limit.

# The default nginx combined log includes the client address, raw request target,
# query string, referrer and user agent. TrendSell's application log already records a
# bounded route template, status and duration, so the proxy access log deliberately
# keeps only non-identifying transport measurements. `log_format` is valid here because
# sites-enabled files are included from nginx's `http` context.
log_format trendsell_safe '$time_iso8601 method=$request_method status=$status '
                          'request_time=$request_time bytes=$body_bytes_sent';

server {
    listen 80;
    listen [::]:80;
    server_name ${TRENDSELL_DOMAIN};
    server_tokens off;
    access_log /var/log/nginx/${TRENDSELL_DOMAIN}.access.log trendsell_safe;
    error_log /var/log/nginx/${TRENDSELL_DOMAIN}.error.log;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://${TRENDSELL_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${TRENDSELL_DOMAIN};
    server_tokens off;

    root /var/www/${TRENDSELL_DOMAIN};
    index index.html;

    access_log /var/log/nginx/${TRENDSELL_DOMAIN}.access.log trendsell_safe;
    error_log /var/log/nginx/${TRENDSELL_DOMAIN}.error.log;

    ssl_certificate /etc/letsencrypt/live/${TRENDSELL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TRENDSELL_DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    # The browser has no third-party origin. Inline styles remain enabled for chart/layout
    # values generated by the application; scripts and every network connection stay self.
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    # API. The app sets its session cookie on path /api, so the prefix is preserved.
    location /api/ {
        client_max_body_size 32k;
        proxy_pass http://127.0.0.1:8021;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_redirect off;
    }

    location = /index.html {
        expires -1;
        try_files $uri =404;
    }

    # Hashed build assets are immutable.
    #
    # nginx `add_header` is *replaced*, never merged: a block that sets any header of its
    # own drops every one inherited from the server block. Setting only Cache-Control here
    # silently served every script and stylesheet with no nosniff, no CSP and no HSTS —
    # the assets are the one thing on this site that is executable content. The security
    # headers are therefore repeated, not inherited.
    # One Cache-Control header, not two: `expires` emits its own, so pairing it with an
    # explicit add_header sent both `max-age=2592000` and `public, immutable` on every
    # asset. Filenames are content-hashed, so a year and `immutable` is the honest answer.
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
