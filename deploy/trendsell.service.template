# systemd unit template for the TrendSell API (action plan P01).
# Install as /etc/systemd/system/trendsell.service. Secrets are read from
# /etc/trendsell/trendsell.env, which is deliberately not in this repository;
# deploy/trendsell.env.template documents the variables it must define.

[Unit]
Description=TrendSell evidence API
After=network.target docker.service
Wants=network.target

[Service]
Type=simple
User=trendsell
Group=trendsell
WorkingDirectory=/opt/trendsell/backend
EnvironmentFile=/etc/trendsell/trendsell.env
UMask=0077

# The application emits one structured, route-template-based request event. Disable
# Uvicorn's second access line: it contains the raw path/query and client address.
ExecStart=/opt/trendsell/venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8021 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=always
RestartSec=5
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trendsell

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/opt/trendsell /etc/trendsell

[Install]
WantedBy=multi-user.target
