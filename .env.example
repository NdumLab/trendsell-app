# ============================================
# TrendSell API Configuration
# ============================================
# Fill in any of the keys below to enable that live data source.
# All integrations fail gracefully — if a key is missing, TrendSell uses
# AI-generated data with a clear "AI estimate" label in the UI.

# -------- LLM (already configured via Emergent Universal Key) --------
EMERGENT_LLM_KEY=sk-emergent-4589cC4A4Ec197372D

# -------- FREE — no key required (live immediately) --------
# Google Trends (via pytrends)      → trending searches, velocity, related queries
# RestCountries                     → country data, currencies, regions
# ExchangeRate.host (public)        → free FX rates fallback

# -------- Amazon Product Data (Rainforest API) --------
# Real Amazon Best Sellers, ASIN data, prices, ratings
# Get your key at: https://www.rainforestapi.com/
RAINFOREST_API_KEY=your_rainforest_api_key_here

# -------- Jungle Scout (Competitor Intelligence) --------
# Real competitor revenue estimates & market-share data
# Get your key at: https://developer.junglescout.com/
JUNGLE_SCOUT_API_KEY=your_jungle_scout_key_here
JUNGLE_SCOUT_API_NAME=your_jungle_scout_name_here

# -------- Open Exchange Rates (live FX) --------
# Live currency conversion for PPP pricing
# Get your key at: https://openexchangerates.org/signup/free
OPEN_EXCHANGE_RATES_APP_ID=your_app_id_here

# -------- ExchangeRate-API (backup free FX) --------
# Get your key at: https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# -------- SerpAPI (Google Keyword Planner data) --------
# Search volume & CPC benchmarks by keyword + country
# Get your key at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# -------- TikTok Creative Center --------
# Trending TikTok Shop products, viral hashtags
# Get access at: https://ads.tiktok.com/creative_center/
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# -------- AliExpress / Alibaba Open API --------
# Real supplier listings (MOQ, price, ratings)
# Get keys at: https://open.aliexpress.com/
ALIEXPRESS_APP_KEY=your_aliexpress_app_key_here
ALIEXPRESS_APP_SECRET=your_aliexpress_app_secret_here

# -------- Helium 10 (Amazon product research) --------
# Keyword search volume, trend data, competitor tracking
# Get your key at: https://www.helium10.com/tools/api/
HELIUM10_API_KEY=your_helium10_api_key_here
