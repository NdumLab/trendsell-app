# Development only. No vendor calls or synthetic production fallback.
APP_ENV=development
# Production supports only the free, invitation-only controlled pilot tier.
RELEASE_TIER=development
DATABASE_URL=sqlite:///./trendsell.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_REGISTRATION=true
RESEARCH_DAILY_LIMIT=20
# Authentication limits per hour: per address for sign-in and registration, and per
# account for sign-in. The account limit is what bounds guessing across many addresses.
LOGIN_IP_HOURLY_LIMIT=30
LOGIN_ACCOUNT_HOURLY_LIMIT=10
REGISTER_IP_HOURLY_LIMIT=10
# Development default exists; set an independent random value of at least 32 characters
# in production so stored network/email rate keys cannot be dictionary-enumerated.
RATE_KEY_SECRET=development-only-rate-key-secret
# Production requires PostgreSQL and explicit HTTPS origins.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/trendsell
# Frontend uses same-origin /api by default. Never put secrets in VITE_*.
# VITE_API_URL=https://api.example.com

# Legacy adapter only; it is not part of the live pilot because the standard affiliate
# terms do not fit TrendSell's durable research record.
AMAZON_CREATORS_ENABLED=false
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_CREATORS_PARTNER_TAG=
AMAZON_CREATORS_MARKETPLACE=www.amazon.com
AMAZON_CREATORS_USAGE_RIGHTS=
AMAZON_CREATORS_TIMEOUT_SECONDS=12

# Selected live-pilot collectors. Keep each disabled until credentials and a non-secret
# reference to the applicable accepted terms, plan and intended-use basis are installed
# server-side. Published terms can establish permission; do not invent an extra written-
# approval requirement. Record any genuinely unresolved target/display question separately.
DATAFORSEO_ENABLED=false
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_USAGE_RIGHTS=
DATAFORSEO_CATALOG_LOCATION_CODE=2840
DATAFORSEO_TRENDS_LOCATION_CODE=2566
DATAFORSEO_RETENTION_DAYS=30
DATAFORSEO_TIMEOUT_SECONDS=15
BRIGHTDATA_JUMIA_ENABLED=false
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_JUMIA_DATASET_ID=
BRIGHTDATA_JUMIA_USAGE_RIGHTS=
BRIGHTDATA_JUMIA_RETENTION_DAYS=30
BRIGHTDATA_TIMEOUT_SECONDS=65
OPEN_EXCHANGE_RATES_ENABLED=false
OPEN_EXCHANGE_RATES_APP_ID=
OPEN_EXCHANGE_RATES_USAGE_RIGHTS=
OPEN_EXCHANGE_RATES_RETENTION_DAYS=365
OPEN_EXCHANGE_RATES_TIMEOUT_SECONDS=12
